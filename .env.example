# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://ivoyzyukfrgmwifiyrfm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Character in the dock: blemi (default, rigged GLB) or anfi (procedural)
NEXT_PUBLIC_CHARACTER=blemi
# Voice in the cockpit (GPT-Live). Needs OPENAI_API_KEY on the server.
NEXT_PUBLIC_VOICE=false

# Server-only secrets: add them yourself (vercel env add NAME --sensitive)
SUPABASE_SERVICE_ROLE_KEY=        # webhook, crons and agents (no user session)
ANTHROPIC_API_KEY=                # Claude for guest replies, the assistant and agents. Without it: rule-based mock
OPENAI_API_KEY=                   # voice (GPT-Live), voice-note transcription and TTS
CRON_SECRET=                      # Vercel sends it as Bearer to /api/cron/*
MCP_TOKEN_SECRET=                 # signs the per-org bearer tokens of the AnfitrIA MCP server

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Managed Agents (scheduled agents), created with `ant apply` from agents/
ANTHROPIC_ENVIRONMENT_ID=
ANTHROPIC_AGENT_PRICING_ID=
ANTHROPIC_AGENT_ANALYTICS_ID=
ANTHROPIC_AGENT_MARKETING_ID=
STAYINGAPI_KEY=                   # comparables for pricing/analytics (optional)
APP_URL=                          # public URL of the app (MCP server URL for the agents)
